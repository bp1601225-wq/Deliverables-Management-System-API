generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  STAFF
  UNIT_HEAD
  MANAGER
  ADMIN
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  
}

enum Rating {
  EXCEEDS
  MEETS
  PARTIAL
  BELOW_STANDARD
}

enum DeliverableStatus {

  SUBMITTED
  REVIEWED

}

model User {
  id        String   @id @default(uuid())
  unitId    String
  positionId  String

  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole

  // Relations
  unit      Unit     @relation(fields: [unitId], references: [id])

weeklySubmissions WeeklySubmission[]

  position Position @relation(fields: [positionId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  // Relations
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Position {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  // Relations
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklySubmission {
id             String           @id @default(uuid())
  userId         String
  weekStart      DateTime
  weekEnd        DateTime
  status         SubmissionStatus @default(DRAFT)
  supportNeeded  String?
  rating         Rating?
  submittedAt    DateTime?
  reviewedAt     DateTime?

  user           User    @relation(fields: [userId], references: [id])
  deliverables   Deliverable[]
  comments       SubmissionComment[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, weekStart])
}

model SubmissionComment {
  id            String           @id @default(uuid())
  submissionId  String
  comment       String

submission WeeklySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ManagersComment {
  id             String           @id @default(uuid())
  weeklySubmissionId    String  @unique
  managerComment    String
}

model Deliverable {
  id                 String            @id @default(uuid())
  weeklySubmissionId String

  title              String
  verificationMethod String
  dueDate            DateTime
  status             DeliverableStatus @default(SUBMITTED)

  weeklySubmission   WeeklySubmission  @relation(fields: [weeklySubmissionId], references: [id])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}



