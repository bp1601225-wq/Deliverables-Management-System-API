generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}


enum UserRole {
  STAFF
  UNIT_HEAD
  MANAGER
  ADMIN
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVIEWED
}

enum Rating {
  EXCEEDS
  MEETS
  PARTIAL
  BELOW_STANDARD
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model User {
  id        String   @id @default(uuid())
  unitId    String
  positionId  String

  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole

  // Relations
  unit      Unit     @relation(fields: [unitId], references: [id])

weeklySubmissions WeeklySubmission[]

  position Position @relation(fields: [positionId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  // Relations
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Position {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  // Relations
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model WeeklySubmission {
  id             String           @id @default(uuid())
  userId         String

  weekStart      DateTime
  weekEnd        DateTime

  status         SubmissionStatus @default(DRAFT)
  supportNeeded  String?
  rating         Rating?

  submittedAt    DateTime?
  reviewedAt     DateTime?
  managerComment String?

  user           User             @relation(fields: [userId], references: [id])
  deliverables   Deliverable[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, weekStart])
}

model Deliverable {
  id                 String            @id @default(uuid())
  weeklySubmissionId String

  title              String
  verificationMethod String
  dueDate            DateTime
  status             DeliverableStatus @default(NOT_STARTED)

  weeklySubmission   WeeklySubmission  @relation(fields: [weeklySubmissionId], references: [id])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}